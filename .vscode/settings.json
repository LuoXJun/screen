{
    // Prettier 加载修复：Volar 3.3.12 注册的同步模块 hook（Module.registerHooks）
    // 与扩展宿主的异步 hook 混用时，import() 加载本地 prettier 的 CJS 入口
    // (index.cjs) 会触发 Node validateLoad 报错（"Expected a string, an ArrayBuffer,
    // or a TypedArray ... but got undefined"），格式化静默失效；
    // 显式指向 ESM 入口(index.mjs)绕过该组合缺陷。命令行 pnpm format 不受影响。
    "prettier.prettierPath": "./node_modules/prettier/index.mjs",
    // TS 服务版本对齐到项目(typescript 5.9.2)
    "typescript.tsdk": "node_modules/typescript/lib",
    // 组件名补全:kebab 输入(<el-butt)命中需要 always 系列强制候选集形态,
    // prefer 系列只影响补出形态、不改变输入匹配(实测 preferKebabCase 下 kebab 输入无提示)
    "vue.suggest.componentNameCasing": "alwaysKebabCase",
    // snippet 建议强制置顶:组件标签 snippet(详见 vue.code-snippets)与同名普通补全
    // 并存时,保证"打全名 + 回车"命中的是展开完整标签的 snippet 项
    "editor.snippetSuggestions": "top",
    // CSS Variable Autocomplete 补全语言:
    // 该扩展不做 SFC 内区域识别,必须以 vue 注册才能覆盖 <style> 块——这是其能力上限。
    // 已排除的替代方案:①去掉 vue 改由 Volar 兜底——实测 Volar 3.x 无 CSS 变量补全
    // (addCSSVariable 仅为收集器)、且 manifest 只声明 vue 单一语言,旧版 vue-postcss/
    // vue-html 虚拟语言 ID 机制已不存在,"仅 style 精准激活"无配置可达成;
    // ②关 quickSuggestions/触发字符抑制 template 干扰——会连带废掉 Volar 组件补全。
    // 故接受共存:template 输入时组件补全与变量项同列(组件前缀匹配通常居前)
    "cssVariables.languages": ["vue", "scss", "postcss", "less", "css"],
    // CSS 变量跳转(CSS Variable Autocomplete 扩展)的扫描范围:仅源码;
    // 排除 dist 构建产物——否则 ctrl+click 会命中压缩产物里的同名定义
    "cssVariables.lookupFiles": ["src/**/*.scss", "src/**/*.vue", "src/**/*.css"],
    // 编辑器文件排除:仅留系统噪声项。dist 不再排除——隐藏构建产物会让
    // 「构建失败/产物缺失」无从肉眼确认(曾被误认为打包未成功);
    // 代价:内置 CSS 语言服务 findFiles 可能重新扫到 dist 内的同名 --变量,
    // ctrl+click 跳转偶发命中压缩产物时再单独处理
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    // 搜索面板同步排除;dist 虽已在 .gitignore(搜索默认吃忽略文件),此处显式声明更稳
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/dist": true
    }
}
