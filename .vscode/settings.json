{
    // Prettier 加载修复：Volar 3.3.12 注册的同步模块 hook（Module.registerHooks）
    // 与扩展宿主的异步 hook 混用时，import() 加载本地 prettier 的 CJS 入口
    // (index.cjs) 会触发 Node validateLoad 报错（"Expected a string, an ArrayBuffer,
    // or a TypedArray ... but got undefined"），格式化静默失效；
    // 显式指向 ESM 入口(index.mjs)绕过该组合缺陷。命令行 pnpm format 不受影响。
    "prettier.prettierPath": "./node_modules/prettier/index.mjs",
    // CSS Variable Autocomplete 补全语言：
    // 该扩展按「宿主文档语言 ID」注册补全（selector 为 {scheme: file, language: <id>}），
    // .vue 文件的语言 ID 是 vue，必须列出 vue，<style lang="scss"> 块内的变量补全才会生效；
    // 若只留 scss/css 等，.vue 文件（含样式块）将完全收不到补全。
    "cssVariables.languages": ["vue", "scss", "postcss", "less", "css"],
    // 抑制 template 干扰(修订版):此前误关了 suggestOnTriggerCharacters——那只掐掉
    // 触发字符路径(连 Volar 的 `<` 弹组件补全一并掐死),而 CSS 变量扩展在 template 里
    // 的骚扰实际来自 quickSuggestions(普通字符自动弹窗,不做 .vue 内区域过滤)。
    // 现改用:.vue 域关闭 quickSuggestions(切断变量列表的自动弹出通路),
    // 触发字符恢复默认——`<` 输入即弹组件补全,且补全框活跃时输入 `-` 只是继续过滤
    // 不会重开变量窗;style 块内需要变量补全时 Ctrl+Space 手动召唤。
    "[vue]": {
        "editor.quickSuggestions": {
            "other": false,
            "comments": false,
            "strings": false
        }
    },
    // CSS 变量跳转(CSS Variable Autocomplete 扩展)的扫描范围:仅源码;
    // 排除 dist 构建产物——否则 ctrl+click 会命中压缩产物里的同名定义
    "cssVariables.lookupFiles": ["src/**/*.scss", "src/**/*.vue", "src/**/*.css"],
    // 编辑器文件排除:仅留系统噪声项。dist 不再排除——隐藏构建产物会让
    // 「构建失败/产物缺失」无从肉眼确认(曾被误认为打包未成功);
    // 代价:内置 CSS 语言服务 findFiles 可能重新扫到 dist 内的同名 --变量,
    // ctrl+click 跳转偶发命中压缩产物时再单独处理
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    // 搜索面板同步排除;dist 虽已在 .gitignore(搜索默认吃忽略文件),此处显式声明更稳
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/dist": true
    }
}
